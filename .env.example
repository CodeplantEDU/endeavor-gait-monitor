# Copy to .env.local. Fill values locally; never commit .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Generate your own code: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
EARLYBIRD_AI_ACCESS_CODE=
# Optional exact HTTPS origin for a separately hosted site; no trailing slash.
EARLYBIRD_ALLOWED_ORIGIN=
# Local development server binds only to 127.0.0.1.
EARLYBIRD_QA_PORT=8774
